# 의존성 · 가상환경
.venv_nli/
node_modules/
__pycache__/
*.pyc

# Codex 임시 토큰·비용 계산 자료
/.codex/tmp/judge-cost-deps/
/.codex/tmp/judge-cost-tokenizer-cache/

# IDE · 에디터 개인 설정
.idea/
.vscode/
*.iml
*.swp
*~

# Claude Code 개인 설정
.claude/

# OS 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 루트의 임시 분석 스크립트 (예: count_json_fmt.py). scripts/python_nli/ 등 하위 폴더 .py는 추적한다
/*.py

# 로컬 환경변수 · 비밀값
.env
.env.*


# 자동 설치 런타임: 모델, CUDA 빌드, 가상환경, 서버 상태
**/.t4-runtime/
**/.t4-state/
**/.t4-automation.lock
load_test_v2/.benchmark.lock*

# Docker 전달 묶음: 이미지 tar, 모델 tar, 로컬 검증 자료
/docker_artifacts/

# 로컬 모델 가중치·캐시·검증 기록 (폴더 안내만 버전 관리)
/model_assets/*
!/model_assets/README.md

# 측정 결과와 실행 로그
**/results/
**/automation_logs/
*.log

# 서버별 설정과 자격 증명
**/engines.local.json
.env
.env.*
!.env.example
!.env.sample

# Python 개발 환경과 캐시
**/__pycache__/
*.py[cod]
.venv/
venv/

# 배포용 압축 파일과 운영체제 파일
*.zip
*.zip.tmp
.DS_Store
Thumbs.db

# Local source-workspace audit; not needed by the cloud runner.
load_test_v2/v1_baseline.json

# 저장소로 복사한 EC2 실험의 모델·실행 환경·전달 자산
/llm-bench/**/model_assets/
/llm-bench/**/prep-venv/
/llm-bench/**/transfer/
/llm-bench/**/future03_validation/
*.gguf
*.safetensors
*.tar
*.tar.gz
*.tar.zst
*.whl

# 복사한 T4 측정 JSON·JSONL은 버전 관리 (기존 다른 results 제외는 유지)
!/llm-bench/**/source/load_test_v2/results/
