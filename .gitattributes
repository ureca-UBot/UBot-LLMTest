# Preserve V2 evaluation evidence and its recorded SHA-256 across platforms.
# (v2 try2 = 2026-09-18 rerun-1328; paths moved 2026-09-28, see model_test_v2/PATH_MAP.csv)
model_test_v2/try2/results/raw/*_20260918_rerun-1328/** -text
model_test_v2/try2/results/raw/scored/*_20260918_rerun-1328/** -text
model_test_v2/try2/results/llm_judge/** -text
model_test_v2/try2/results/report/rerun-20260918-1328.json -text
model_test_v2/try2/results/summary/** -text

# Keep the serving Docker snapshot source manifest identical on Windows and Linux.
servingtest/.gitattributes text eol=lf
servingtest/results/20261002/** text eol=lf
# v4~ 데이터셋 CSV는 prepare_dataset.js가 CRLF로 쓰고 그 바이트의 SHA-256을 dataset_manifest.json과
# run_info.json에 기록한다. 줄바꿈 변환을 막아 Windows·EC2(Linux)에서 같은 바이트를 받게 한다.
data/eval_sets/test_set3/*.csv -text
data/eval_sets/test_set4/*.csv -text

# v4~ 결과: build_batch_manifest.js가 generation.jsonl 바이트의 SHA-256을 report/<batch>.json에 기록하고
# judge_prepare.js가 다시 검사한다. core.autocrlf=true인 PC에서 받으면 CRLF로 바뀌어 "배치 이후 저장 답변이
# 바뀌었습니다"로 멈추므로 변환을 막는다(다른 PC에서 Judge를 돌릴 때).
model_test_v4/*/results/** -text
prompts_test_v*/*/results/** -text
